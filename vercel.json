{
  "buildCommand": "node scripts/generate-runtime-config.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/runtime-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/data/historical-reservations.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:asset(og-image\\.jpg|gallery_01\\.jpg|0057\\.jpg|0073\\.jpg|0075\\.jpg|0138_\\.jpg|_0049\\.jpg|_0049_poster\\.webp|_0049_mobile\\.mp4|_0049_desktop\\.webm|_0049_animation\\.mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:internal(admin|admin\\.html|admin-analytics\\.html|mvno|mvno\\.html|qr|qr\\.html|imweb-reservation-widget-full|imweb-reservation-widget-full\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/analytics",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/:privatePage(board|board\\.html|reservation|reservation\\.html|status|status\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/raw/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/raw",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/guide/", "destination": "/guide", "permanent": true },
    { "source": "/reservation/", "destination": "/reservation", "permanent": true },
    { "source": "/board/", "destination": "/board", "permanent": true },
    { "source": "/status/", "destination": "/status", "permanent": true },
    { "source": "/mvno/", "destination": "/mvno", "permanent": true },
    { "source": "/qr/", "destination": "/qr", "permanent": true },
    { "source": "/baby/", "destination": "/baby", "permanent": true },
    { "source": "/family/", "destination": "/family", "permanent": true },
    { "source": "/hanok-snap/", "destination": "/hanok-snap", "permanent": true },
    { "source": "/pricing/", "destination": "/pricing", "permanent": true },
    { "source": "/faq/", "destination": "/faq", "permanent": true },
    { "source": "/location/", "destination": "/location", "permanent": true },
    { "source": "/guide.html", "destination": "/guide", "permanent": true },
    { "source": "/reservation.html", "destination": "/reservation", "permanent": true },
    { "source": "/board.html", "destination": "/board", "permanent": true },
    { "source": "/status.html", "destination": "/status", "permanent": true },
    { "source": "/mvno.html", "destination": "/mvno", "permanent": true },
    { "source": "/qr.html", "destination": "/qr", "permanent": true },
    { "source": "/baby.html", "destination": "/baby", "permanent": true },
    { "source": "/family.html", "destination": "/family", "permanent": true },
    { "source": "/hanok-snap.html", "destination": "/hanok-snap", "permanent": true },
    { "source": "/pricing.html", "destination": "/pricing", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/location.html", "destination": "/location", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/board", "destination": "/board.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/analytics", "destination": "/admin-analytics.html" },
    { "source": "/mvno", "destination": "/mvno.html" },
    { "source": "/qr", "destination": "/qr.html" },
    { "source": "/reservation", "destination": "/reservation.html" },
    { "source": "/status", "destination": "/status.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/baby", "destination": "/baby.html" },
    { "source": "/family", "destination": "/family.html" },
    { "source": "/hanok-snap", "destination": "/hanok-snap.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/location", "destination": "/location.html" },
    { "source": "/og-image.jpg", "destination": "/assets/images/social/og-image.jpg" },
    { "source": "/gallery_01.jpg", "destination": "/assets/images/gallery/gallery_01.jpg" },
    { "source": "/0057.jpg", "destination": "/assets/images/gallery/0057.jpg" },
    { "source": "/0073.jpg", "destination": "/assets/images/gallery/0073.jpg" },
    { "source": "/0075.jpg", "destination": "/assets/images/gallery/0075.jpg" },
    { "source": "/0138_.jpg", "destination": "/assets/images/gallery/0138_.jpg" },
    { "source": "/_0049.jpg", "destination": "/assets/images/hero/_0049.jpg" },
    { "source": "/_0049_poster.webp", "destination": "/assets/images/hero/_0049_poster.webp" },
    { "source": "/_0049_mobile.mp4", "destination": "/assets/video/hero/_0049_mobile.mp4" },
    { "source": "/_0049_desktop.webm", "destination": "/assets/video/hero/_0049_desktop.webm" },
    { "source": "/_0049_animation.mp4", "destination": "/assets/video/hero/_0049_animation.mp4" }
  ]
}
